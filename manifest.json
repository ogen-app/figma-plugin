{
  "name": "Ogen",
  "id": "ogen-send-to-ogen",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "menu": [
    {
      "name": "Send to Ogen",
      "command": "send"
    },
    {
      "name": "Campaign boards",
      "command": "boards"
    }
  ],
  "relaunchButtons": [
    {
      "command": "send",
      "name": "Send to Ogen",
      "multipleSelection": true
    },
    {
      "command": "boards",
      "name": "Campaign board"
    }
  ],
  "editorType": [
    "figma"
  ],
  "documentAccess": "dynamic-page",
  "permissions": [
    "currentuser"
  ],
  "networkAccess": {
    "allowedDomains": [
      "https://api.getogen.com",
      "https://*.r2.cloudflarestorage.com"
    ],
    "devAllowedDomains": [
      "http://localhost:9001",
      "https://api.dev.getogen.com"
    ],
    "reasoning": "Uploads to the Ogen API. Animated frames sent as video upload straight to Ogen's Cloudflare R2 storage through short-lived presigned URLs issued by the Ogen API."
  }
}
